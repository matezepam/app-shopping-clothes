# Puerto único de acceso a la aplicación completa (frontend + API por Nginx).
APP_HTTP_PORT=8088

# PostgreSQL local. Cambiar la contraseña antes de un despliegue compartido.
POSTGRES_USER=sprint_app
POSTGRES_PASSWORD=SprintLocal#2026
IDENTITY_DATABASE=sprint_identity
COMMERCE_DATABASE=sprint_commerce
IDENTITY_DB_POOL_MAX_SIZE=5
IDENTITY_DB_POOL_MIN_IDLE=1
COMMERCE_DB_POOL_MAX_SIZE=10
COMMERCE_DB_POOL_MIN_IDLE=2

# pgAdmin local para inspección del esquema y generación del ERD.
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@sprintclothes.com
PGADMIN_PASSWORD=SprintPgAdmin#2026

# Dominio público del frontend. Se aceptan varios separados por coma.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8088
APP_WHATSAPP_BUSINESS_NUMBER=593939051525

# Amazon Cognito. scripts/docker-up.ps1 importa automáticamente los valores
# de backend/.env.cognito.generated cuando ese archivo existe.
AWS_COGNITO_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=us-east-1_example
AWS_COGNITO_CLIENT_ID=exampleclientid
AWS_COGNITO_CLIENT_SECRET=
